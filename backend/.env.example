NETWORK=bsc-testnet
MANDATE_OPERATOR_ADDRESS=0x0000000000000000000000000000000000000000
WALLET_PASSWORD=replace-with-a-strong-local-password
# PRIVATE_KEY is only needed for first wallet import. Remove it after the SDK
# encrypts the key in its local keystore. Never expose it to the web frontend.
PRIVATE_KEY=
MANDATE_LIVE_TRANSACTIONS=false
MANDATE_ALLOWED_PROVIDERS=
MANDATE_MAX_BUDGET_WEI=1000000000000000000
MANDATE_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ERC8183_AGENT_URL=http://127.0.0.1:8003/erc8183
ERC8183_SERVICE_PRICE=100000000000000000
